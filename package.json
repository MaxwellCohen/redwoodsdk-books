{
  "name": "redwoodsdk-books",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "types": "tsc --noEmit",
    "generate": "wrangler types --include-runtime false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed-authors && pnpm db:seed-books",
    "db:seed-authors": "tsx src/lib/db/seed-authors.ts",
    "db:seed-books": "tsx src/lib/db/seed-books.ts",
    "db:seed-thumbhash": "tsx src/lib/db/seed-thumbhash.ts",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "preview:cloudflare": "pnpm build && wrangler dev",
    "deploy:vercel": "npx --yes vercel --prod --yes",
    "deploy:netlify": "pnpm build && npx --yes netlify-cli deploy --prod --no-build"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.38",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/blobs": "^11.1.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.4",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.0.0",
    "react-server-dom-webpack": "19.3.0",
    "rwsdk": "1.7.5",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1",
    "unlazy": "^2.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "~26.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "~8.4.0",
    "wrangler": "4.118.0"
  }
}
