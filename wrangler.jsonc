{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redwoodsdk-books-optimized",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
